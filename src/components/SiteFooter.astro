---
/**
 * 全ページ共通のフッター。
 *
 * これまでフッターはトップページにしか無く、区ページ・記事・運営者情報には
 * 立場の説明も紹介手数料の開示も出ていなかった。
 * 記事にアフィリエイトを入れる前提では、開示が全ページに必要になる
 * （景品表示法のステルスマーケティング規制、および広告審査への備え）。
 */
const areas = [
  ['higashinada', '東灘区'], ['nada', '灘区'], ['chuo', '中央区'],
  ['hyogo', '兵庫区'], ['kita', '北区'], ['nagata', '長田区'],
  ['suma', '須磨区'], ['tarumi', '垂水区'], ['nishi', '西区'],
];
---

<footer class="text-blue-300 text-xs py-8 px-5 text-center" style="background-color: #040e22">
  <p class="font-bold text-white text-sm mb-1">神戸お片付けサポートセンター</p>
  <p class="mb-2">神戸市全9区対応｜遺品整理・ゴミ屋敷清掃・生前整理・特殊清掃の業者比較・紹介</p>
  <p class="mb-4">
    対応エリア：{areas.map(([slug, label], i) => (
      <>
        {i > 0 && ' / '}
        <a href={`/area/${slug}`} class="underline hover:text-white">{label}</a>
      </>
    ))}
  </p>

  <div class="max-w-2xl mx-auto border-t border-white/10 pt-4 mt-4">
    <p class="text-blue-200/80 leading-relaxed mb-3">
      当サイトは遺品整理業者ではなく、条件に合う業者を無料でご紹介する<strong class="text-blue-100">比較・紹介サービス</strong>です。
      実際の作業およびご契約は、ご紹介先の業者との間で直接行っていただきます。
      当サイトは、ご紹介した業者から<strong class="text-blue-100">紹介手数料を受け取る場合があります</strong>。
      また、記事の一部に<strong class="text-blue-100">広告（アフィリエイトプログラム）を含みます</strong>。
      いずれの場合も、お客様に追加の費用が発生することはありません。
    </p>
    <nav class="flex flex-wrap justify-center gap-x-4 gap-y-1">
      <a href="/" class="underline hover:text-white">ホーム</a>
      <a href="/area" class="underline hover:text-white">対応エリア</a>
      <a href="/blog" class="underline hover:text-white">お役立ち記事</a>
      <a href="/operator" class="underline hover:text-white">運営者情報</a>
      <a href="/privacy" class="underline hover:text-white">プライバシーポリシー</a>
    </nav>
  </div>
  <p class="mt-4 text-blue-500">© 2026 神戸お片付けサポートセンター. All Rights Reserved.</p>
</footer>

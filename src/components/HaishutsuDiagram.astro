---
/**
 * 搬出条件の図解。
 *
 * 実際の作業写真は使わない。当サイトは施工業者ではないため、
 * 作業風景の写真を載せると自社で作業しているように見えてしまう。
 * 代わりに、費用が変わる理由（搬出条件）を図で説明する。
 *
 * SVGはインラインで持つ（外部リクエストを増やさず、表示も速い）。
 */
const cases = [
  {
    key: 'slope',
    title: '坂道・階段の多い住宅地',
    wards: '北区・須磨区・垂水区 など',
    desc: 'トラックを家の前まで寄せられず、荷物を人力で運ぶ「小運搬」が発生します。距離があるほど人手と時間がかかります。',
    effect: '費用が上がりやすい',
  },
  {
    key: 'narrow',
    title: '道幅が狭い住宅街',
    wards: '東灘区・灘区の一部 など',
    desc: '大型トラックが進入できず、小型車で複数回に分けて運ぶことがあります。往復が増えるほど作業時間が延びます。',
    effect: '作業日数が延びやすい',
  },
  {
    key: 'elevator',
    title: 'エレベーターのない集合住宅',
    wards: '中央区・兵庫区 など',
    desc: '階段での搬出になります。階数が上がるほど負担が大きく、養生（壁や床の保護）の範囲も広くなります。',
    effect: '人件費が上がりやすい',
  },
]
---

<section class="bg-white py-12 px-5" aria-labelledby="haishutsu-heading">
  <div class="max-w-3xl mx-auto">
    <p class="text-center text-xs font-bold tracking-widest text-[#1a4480] mb-2 uppercase">費用が変わる理由</p>
    <h2 id="haishutsu-heading" class="text-xl md:text-2xl font-black text-center text-[#081a38] mb-3">
      神戸は<span class="text-[#c98700]">「運び出しやすさ」</span>で費用が変わります
    </h2>
    <p class="text-center text-gray-500 text-sm mb-8 leading-relaxed">
      同じ間取りでも、現場の条件によって必要な人数と時間が変わります。<br class="hidden sm:block" />
      神戸市で起きやすい3つの条件を図で示します。
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {cases.map((c) => (
        <article class="bg-[#f8fafc] rounded-2xl p-5 border border-slate-100 flex flex-col">
          <div class="bg-white rounded-xl p-3 mb-4 border border-slate-100">
            {c.key === 'slope' && (
              <svg viewBox="0 0 200 120" class="w-full h-auto" role="img" aria-label="坂道の住宅地でトラックが家の前まで寄せられず、荷物を人力で運ぶ様子の図">
                <rect width="200" height="120" fill="#f0f4fa" />
                <path d="M0 100 L200 45" stroke="#c9d6e8" stroke-width="12" fill="none" />
                <rect x="140" y="18" width="42" height="30" rx="3" fill="#1a4480" />
                <path d="M140 18 L161 4 L182 18 Z" fill="#0f2d5c" />
                <rect x="155" y="32" width="12" height="16" fill="#f5c842" />
                <rect x="12" y="66" width="46" height="22" rx="3" fill="#e8752a" />
                <rect x="46" y="72" width="16" height="16" rx="2" fill="#c2601f" />
                <circle cx="24" cy="92" r="7" fill="#3a3a3a" />
                <circle cx="54" cy="92" r="7" fill="#3a3a3a" />
                <g stroke="#1a4480" stroke-width="2.5" fill="none" stroke-linecap="round">
                  <circle cx="92" cy="68" r="5" fill="#1a4480" stroke="none" />
                  <path d="M92 73 L92 84 M92 78 L85 82 M92 78 L99 82 M92 84 L87 95 M92 84 L97 95" />
                  <rect x="99" y="70" width="12" height="10" rx="1.5" fill="#c98700" stroke="none" />
                </g>
                <text x="100" y="114" text-anchor="middle" font-size="11" fill="#5a6b80">人力で運ぶ距離が発生</text>
              </svg>
            )}
            {c.key === 'narrow' && (
              <svg viewBox="0 0 200 120" class="w-full h-auto" role="img" aria-label="道幅が狭く大型トラックが進入できず、小型車で複数回運ぶ様子の図">
                <rect width="200" height="120" fill="#f0f4fa" />
                <rect x="0" y="8" width="52" height="104" fill="#dbe4f0" />
                <rect x="148" y="8" width="52" height="104" fill="#dbe4f0" />
                <rect x="52" y="8" width="96" height="104" fill="#e9eef6" />
                <g stroke="#c98700" stroke-width="2" stroke-dasharray="5 4">
                  <path d="M52 20 L148 20" />
                </g>
                <text x="100" y="16" text-anchor="middle" font-size="10" fill="#c98700">道幅がせまい</text>
                <rect x="66" y="40" width="68" height="26" rx="3" fill="#b8c4d4" opacity="0.5" />
                <text x="100" y="57" text-anchor="middle" font-size="10" fill="#8a97a8">大型は進入不可</text>
                <rect x="74" y="78" width="40" height="18" rx="3" fill="#e8752a" />
                <rect x="106" y="83" width="14" height="13" rx="2" fill="#c2601f" />
                <circle cx="84" cy="99" r="6" fill="#3a3a3a" />
                <circle cx="112" cy="99" r="6" fill="#3a3a3a" />
                <text x="100" y="114" text-anchor="middle" font-size="11" fill="#5a6b80">小型車で複数回に分けて搬出</text>
              </svg>
            )}
            {c.key === 'elevator' && (
              <svg viewBox="0 0 200 120" class="w-full h-auto" role="img" aria-label="エレベーターのない集合住宅で、階段を使って荷物を搬出する様子の図">
                <rect width="200" height="120" fill="#f0f4fa" />
                <rect x="24" y="14" width="92" height="90" rx="3" fill="#1a4480" />
                <g fill="#f5c842">
                  <rect x="34" y="24" width="14" height="12" /><rect x="56" y="24" width="14" height="12" /><rect x="78" y="24" width="14" height="12" />
                  <rect x="34" y="46" width="14" height="12" /><rect x="56" y="46" width="14" height="12" /><rect x="78" y="46" width="14" height="12" />
                  <rect x="34" y="68" width="14" height="12" /><rect x="56" y="68" width="14" height="12" /><rect x="78" y="68" width="14" height="12" />
                </g>
                <g fill="#dbe4f0">
                  <rect x="124" y="86" width="18" height="18" /><rect x="136" y="68" width="18" height="36" />
                  <rect x="148" y="50" width="18" height="54" /><rect x="160" y="32" width="18" height="72" />
                </g>
                <g stroke="#c98700" stroke-width="2.5" fill="none" stroke-linecap="round">
                  <circle cx="140" cy="56" r="4.5" fill="#c98700" stroke="none" />
                  <path d="M140 61 L140 71 M140 65 L134 69 M140 65 L146 69 M140 71 L136 80 M140 71 L145 80" />
                </g>
                <text x="100" y="114" text-anchor="middle" font-size="11" fill="#5a6b80">階段での搬出・養生が必要</text>
              </svg>
            )}
          </div>

          <h3 class="font-black text-[#081a38] text-base mb-1">{c.title}</h3>
          <p class="text-[11px] text-[#1a4480] font-bold mb-2">{c.wards}</p>
          <p class="text-gray-600 text-sm leading-relaxed flex-1">{c.desc}</p>
          <p class="mt-3 inline-block self-start bg-[#fdf0e6] text-[#b8571a] text-xs font-bold px-2.5 py-1 rounded">{c.effect}</p>
        </article>
      ))}
    </div>

    <p class="mt-6 text-center text-gray-500 text-sm leading-relaxed">
      こうした条件は、現地を見なければ判断できません。<br class="hidden sm:block" />
      ご相談時にお住まいの区と建物の状況をお知らせいただくと、対応できる業者をご案内しやすくなります。
    </p>
  </div>
</section>

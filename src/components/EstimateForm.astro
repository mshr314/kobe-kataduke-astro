---
/**
 * 無料見積もりフォーム（トップページと広告用LPで共通）
 *
 * 送信先は /api/estimate。成功したときだけ完了画面に切り替え、
 * GA4 に generate_lead を送る（個人情報は送らない）。
 * 二重管理を避けるため、トップと広告用LPはこの部品を使う。
 */
---

<section class="bg-[#081a38] py-14 px-5 text-white" aria-labelledby="form-heading" id="estimate-form">
  <div class="max-w-2xl mx-auto">
    <p class="text-center text-xs font-bold tracking-widest text-[#f5c842] mb-2 uppercase">無料見積りフォーム</p>
    <h2 id="form-heading" class="text-xl md:text-2xl font-black text-center mb-2">今すぐ<span class="text-[#f5c842]">無料見積りを依頼</span>する</h2>
    <p class="text-center text-blue-200 text-sm mb-8">24時間受付。しつこい営業・勧誘は一切いたしません。</p>
    <form id="estimateForm" class="space-y-4" novalidate>
      <!-- ハニーポット：人には見えない。自動投稿だけがここを埋める -->
      <div class="hidden" aria-hidden="true">
        <label for="_hp">この欄は入力しないでください</label>
        <input type="text" id="_hp" name="_hp" tabindex="-1" autocomplete="off" />
      </div>
      <div>
        <label for="roomType" class="block text-sm font-bold mb-1 text-blue-100">物件の間取り <span class="text-red-400">*</span></label>
        <select id="roomType" name="roomType" required class="w-full bg-[#0f2d5c] border border-white/20 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:ring-2 focus:ring-[#e8a900]">
          <option value="" disabled selected>--- 選択してください ---</option>
          <option value="1K">1K・1R（30,000円〜）</option>
          <option value="1LDK">1DK・1LDK（80,000円〜）</option>
          <option value="2LDK">2DK・2LDK（120,000円〜）</option>
          <option value="3LDK">3DK・3LDK（150,000円〜）</option>
          <option value="4LDK+">4LDK・一戸建て（250,000円〜）</option>
          <option value="unknown">わからない／その他</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-bold mb-2 text-blue-100">ご依頼内容</label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          {['遺品整理', '生前整理', 'ゴミ屋敷清掃', '特殊清掃'].map(s => (
            <label class="flex items-center gap-2 bg-[#0f2d5c] border border-white/20 rounded-xl px-3 py-2.5 cursor-pointer hover:bg-[#1a4480] transition-colors text-sm">
              <input type="checkbox" name="service" value={s} class="accent-[#e8a900]"/> {s}
            </label>
          ))}
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="name" class="block text-sm font-bold mb-1 text-blue-100">お名前 <span class="text-red-400">*</span></label>
          <input type="text" id="name" name="name" required placeholder="例：山田 太郎" class="w-full bg-[#0f2d5c] border border-white/20 rounded-xl px-4 py-3 text-white placeholder-blue-300/50 text-sm focus:outline-none focus:ring-2 focus:ring-[#e8a900]"/>
        </div>
        <div>
          <label for="phone" class="block text-sm font-bold mb-1 text-blue-100">お電話番号 <span class="text-blue-300 font-normal text-xs ml-1">（任意）</span></label>
          <input type="tel" id="phone" name="phone" placeholder="例：090-0000-0000" class="w-full bg-[#0f2d5c] border border-white/20 rounded-xl px-4 py-3 text-white placeholder-blue-300/50 text-sm focus:outline-none focus:ring-2 focus:ring-[#e8a900]"/>
        </div>
      </div>

      <div>
        <label for="email" class="block text-sm font-bold mb-1 text-blue-100">
          メールアドレス <span class="text-red-400">*</span>
        </label>
        <input type="email" id="email" name="email" required inputmode="email" autocomplete="email" placeholder="例：example@example.com" class="w-full bg-[#0f2d5c] border border-white/20 rounded-xl px-4 py-3 text-white placeholder-blue-300/50 text-sm focus:outline-none focus:ring-2 focus:ring-[#e8a900]"/>
        <p class="text-blue-300 text-xs mt-1.5 leading-relaxed">
          こちらのアドレス宛にご返信します。お間違いのないようご確認ください。
        </p>
      </div>
      <div>
        <label for="message" class="block text-sm font-bold mb-1 text-blue-100">ご状況・ご要望 <span class="text-blue-300 font-normal text-xs ml-1">（任意）</span></label>
        <textarea id="message" name="message" rows="3" placeholder="例：神戸市灘区の実家（3LDK）の遺品整理を検討しています…" class="w-full bg-[#0f2d5c] border border-white/20 rounded-xl px-4 py-3 text-white placeholder-blue-300/50 text-sm focus:outline-none focus:ring-2 focus:ring-[#e8a900] resize-none"></textarea>
      </div>
      <div id="formError" class="hidden bg-red-900/50 border border-red-500 text-red-200 text-sm rounded-xl px-4 py-3"></div>
      <button type="submit" id="submitBtn" class="cta-btn w-full text-lg py-5 px-8 mt-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
        <span>無料で見積りを依頼する</span>
      </button>
      <p class="text-center text-blue-300 text-xs">✅ 送信後のしつこい営業・勧誘は一切ありません</p>
    </form>
    <div id="formSuccess" class="hidden text-center py-10">
      <div class="text-5xl mb-4">✅</div>
      <h3 class="font-black text-xl text-[#f5c842] mb-3">送信が完了しました！</h3>
      <p class="text-blue-100 text-sm leading-relaxed">
        ご入力のメールアドレス宛に、<strong class="text-white">当日〜翌営業日中</strong>にご返信し、<br class="hidden sm:block" />
        ご状況に合う業者をご案内します。
      </p>
      <p class="text-blue-300 text-xs mt-3 leading-relaxed">
        迷惑メールフォルダに振り分けられることがあります。<br class="hidden sm:block" />
        しばらく届かない場合は、そちらもご確認ください。
      </p>
      <p class="text-blue-300 text-xs mt-3 leading-relaxed">
        お急ぎの場合は、LINEからご連絡いただくとより早くご案内できます。
      </p>
    </div>
  </div>
</section>

<script>
  (function () {
    const form = document.getElementById('estimateForm');
    const successMsg = document.getElementById('formSuccess');
    const errorMsg = document.getElementById('formError');
    const submitBtn = document.getElementById('submitBtn');
    if (!form || !successMsg || !errorMsg || !submitBtn) return;
    const originalLabel = submitBtn.textContent;

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      errorMsg.classList.add('hidden');

      const name = document.getElementById('name').value.trim();
      const phone = document.getElementById('phone').value.trim();
      const email = document.getElementById('email').value.trim();
      const roomType = document.getElementById('roomType').value;
      const errors = [];
      if (!name) errors.push('お名前をご入力ください。');
      // 返信はメールで行うため、メールアドレスを必須にする（電話番号は任意）
      if (!email) errors.push('メールアドレスをご入力ください。');
      else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) errors.push('メールアドレスの形式をご確認ください。');
      if (!roomType) errors.push('間取りを選択してください。');
      if (errors.length > 0) {
        errorMsg.innerHTML = errors.join('<br/>');
        errorMsg.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = '送信中...';

      try {
        const res = await fetch('/api/estimate', {
          method: 'POST',
          body: new FormData(form),
        });
        const data = await res.json().catch(function () { return { ok: false }; });

        if (res.ok && data.ok) {
          // GA4 に成果（見積もり依頼）を送る。送信に成功したときだけ、1回だけ。
          // 名前・連絡先・相談内容などの個人情報は送らない。
          // from_page：このページに来る直前に見ていたサイト内のページ（どの地域ページ・記事から来たか）
          var hp = form.querySelector('[name="_hp"]');
          if (typeof window.gtag === 'function' && !(hp && hp.value)) {
            var fromPage = '(直接・外部)';
            try {
              var ref = new URL(document.referrer);
              if (ref.origin === location.origin) fromPage = ref.pathname;
            } catch (_) {}
            var services = Array.prototype.map
              .call(form.querySelectorAll('[name="service"]:checked'), function (el) { return el.value; })
              .join(',');
            window.gtag('event', 'generate_lead', {
              form_name: 'estimate',
              room_type: roomType,
              services: services || '(未選択)',
              from_page: fromPage,
            });
          }

          // 実際に送信できたときだけ完了画面に切り替える
          form.classList.add('hidden');
          successMsg.classList.remove('hidden');
          successMsg.scrollIntoView({ block: 'center' });
          return;
        }

        errorMsg.textContent = data.error || '送信に失敗しました。お手数ですがLINEからご相談ください。';
        errorMsg.classList.remove('hidden');
      } catch (err) {
        errorMsg.textContent = '通信に失敗しました。電波状況をご確認のうえ、再度お試しください。';
        errorMsg.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    });
  })();
</script>

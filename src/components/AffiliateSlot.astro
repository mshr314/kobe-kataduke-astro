---
/**
 * 記事内の広告枠。
 * URLが未設定の案件は何も描画しない（空の枠を見せないため）。
 * 「PR」の表示は必須（ステルスマーケティング規制への対応）。
 */
import { offerFor } from '../config/affiliate'

interface Props {
  slug: string
}
const { slug } = Astro.props
const offer = offerFor(slug)
---

{offer && (
  <aside class="mt-10 rounded-xl border border-gray-200 bg-gray-50 p-5" aria-label="広告">
    <div class="flex items-center gap-2 mb-2">
      <span class="text-[10px] font-bold text-gray-500 border border-gray-300 rounded px-1.5 py-0.5">PR</span>
      <span class="text-[11px] text-gray-500">広告（アフィリエイトプログラム）を含みます</span>
    </div>
    <p class="font-bold text-gray-900 mb-1.5">{offer.heading}</p>
    <p class="text-sm text-gray-600 leading-relaxed mb-4">{offer.body}</p>
    <a
      href={offer.url}
      target="_blank"
      rel="sponsored nofollow noopener"
      data-affiliate={slug}
      class="inline-flex items-center gap-2 rounded-lg bg-[#0f2d5c] px-5 py-3 text-sm font-bold text-white hover:bg-[#1a4480] transition-colors"
    >
      {offer.cta}
      <span aria-hidden="true">→</span>
    </a>
    <p class="mt-3 text-[11px] text-gray-500 leading-relaxed">
      当サイトを経由してお申し込みがあった場合、提供元から当サイトに手数料が支払われることがあります。お客様の費用が増えることはありません。
    </p>
  </aside>
)}

<script is:inline>
  document.querySelectorAll('[data-affiliate]').forEach(function (a) {
    a.addEventListener('click', function () {
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'affiliate_click', { article: a.getAttribute('data-affiliate') || '' });
      }
    });
  });
</script>

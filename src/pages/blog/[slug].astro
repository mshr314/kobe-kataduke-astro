---
import Layout from '../../layouts/Layout.astro'
import ContactCta from '../../components/ContactCta.astro'
import WardLinks from '../../components/WardLinks.astro'
import { fetchBlogPost, fetchBlogPosts } from '../../sanity/client'
// PortableTextをシンプルなHTMLに変換するユーティリティ
function ptToHtml(blocks: any[]): string {
  if (!blocks) return ''
  return blocks.map(block => {
    if (block._type === 'block') {
      const text = (block.children || []).map((c: any) => c.text || '').join('')
      const style = block.style || 'normal'
      if (style === 'h2') return `<h2 class="text-xl font-black text-navy-800 mt-8 mb-3">${text}</h2>`
      if (style === 'h3') return `<h3 class="text-lg font-bold text-navy-700 mt-6 mb-2">${text}</h3>`
      if (style === 'blockquote') return `<blockquote class="border-l-4 border-navy-300 pl-4 text-gray-500 italic my-4">${text}</blockquote>`
      return `<p class="mb-4 leading-relaxed">${text}</p>`
    }
    if (block._type === 'image' && block.asset) {
      return `<img src="${block.asset.url || ''}" alt="${block.alt || ''}" class="rounded-xl my-6 w-full"/>`
    }
    return ''
  }).join('')
}

export const prerender = false

const { slug } = Astro.params

let post: any = null
try {
  if (slug) post = await fetchBlogPost(slug)
} catch (e) {}

if (!post) {
  return Astro.redirect('/blog')
}

// 関連記事（同記事を除く新着3件）。読了後に次の記事へ回遊させる。
let related: any[] = []
try {
  const all = await fetchBlogPosts()
  related = (all || []).filter((p: any) => p.slug?.current !== slug).slice(0, 3)
} catch (e) {}

const categoryLabels: Record<string, string> = {
  'isan-seiri': '遺品整理',
  'seizen-seiri': '生前整理',
  'gomiyashiki': 'ゴミ屋敷清掃',
  'tokusu-seiou': '特殊清掃',
  'area-guide': '地域ガイド',
  'tips': 'お役立ち情報',
}

const SITE = 'https://kobe-kataduke-support.jp'
const pageUrl = `${SITE}/blog/${slug}`

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": pageUrl,
  "headline": post.seoTitle || post.title,
  "description": post.seoDescription || post.excerpt || '',
  "inLanguage": "ja",
  "datePublished": post.publishedAt,
  "dateModified": post._updatedAt || post.publishedAt,
  "mainEntityOfPage": pageUrl,
  "author": {
    "@type": "Organization",
    "name": "神戸お片付けサポートセンター",
    "url": SITE,
  },
  "publisher": {
    "@type": "Organization",
    "name": "神戸お片付けサポートセンター",
    "url": SITE,
  },
}

// パンくず（画面表示と一致させる）
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", position: 1, name: "トップ", item: `${SITE}/` },
    { "@type": "ListItem", position: 2, name: "お役立ち記事", item: `${SITE}/blog` },
    { "@type": "ListItem", position: 3, name: post.title, item: pageUrl },
  ],
}
---

<Layout
  title={`${post.seoTitle || post.title} | 神戸お片付けサポートセンター`}
  description={post.seoDescription || post.excerpt || ''}
  canonical={pageUrl}
  schema={[articleSchema, breadcrumbSchema]}
>

<header class="bg-[#081a38] sticky top-0 z-50 shadow-lg">
  <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between gap-2">
    <a href="/" class="flex flex-col leading-tight">
      <span class="text-[#f5c842] font-black text-lg tracking-tight">神戸お片付けサポートセンター</span>
      <span class="text-blue-200 text-xs mt-0.5">遺品整理・ゴミ屋敷清掃の専門窓口</span>
    </a>
    <a href="https://line.me/R/ti/p/@622cifkz" target="_blank" rel="noopener" class="cta-btn tel-link text-sm px-5 py-2.5">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 5.82 2 10.5c0 2.67 1.5 5.05 3.86 6.6-.13.5-.7 2.5-.72 2.66 0 0-.02.12.06.17.08.05.18.02.18.02.24-.03 2.8-1.84 3.24-2.15.45.06.9.1 1.38.1 5.52 0 10-3.82 10-8.5S17.52 2 12 2z"/></svg>
      <span class="font-black">LINEで無料相談</span>
    </a>
  </div>
</header>

<main class="min-h-screen bg-white py-12 px-5">
  <div class="max-w-2xl mx-auto">
    <nav class="text-xs text-gray-400 mb-6">
      <a href="/" class="hover:text-[#1a4480]">トップ</a> &rsaquo;
      <a href="/blog" class="hover:text-[#1a4480]">お役立ち記事</a> &rsaquo;
      <span class="text-gray-600">{post.title}</span>
    </nav>

    <article itemscope itemtype="https://schema.org/BlogPosting">
      <div class="mb-4 flex items-center gap-2">
        <span class="inline-block bg-[#0f2d5c] text-[#f5c842] text-xs px-3 py-1 rounded-full font-bold">
          {categoryLabels[post.category] || 'お役立ち情報'}
        </span>
        <time class="text-gray-400 text-xs" itemprop="datePublished" datetime={post.publishedAt}>
          {post.publishedAt?.replace(/-/g, '.')}
        </time>
      </div>

      <h1 class="text-xl md:text-3xl font-black text-[#081a38] leading-snug mb-6" itemprop="headline">
        {post.title}
      </h1>

      {post.excerpt && (
        <p class="bg-[#f0f4fa] border-l-4 border-[#1a4480] px-4 py-3 text-gray-600 text-sm leading-relaxed mb-8 rounded-r-xl">
          {post.excerpt}
        </p>
      )}

      <div class="prose prose-sm md:prose-base max-w-none text-gray-700 leading-relaxed" itemprop="articleBody">
        {post.body ? (
          <Fragment set:html={ptToHtml(post.body)} />
        ) : (
          <p class="text-gray-400 text-center py-12">記事のコンテンツを読み込み中...</p>
        )}
      </div>
    </article>

    <div class="mt-12 section-divider"></div>

    <div class="mt-10">
      <ContactCta />
    </div>

    {related.length > 0 && (
      <nav class="mt-12" aria-label="関連記事">
        <h2 class="text-base font-black text-[#081a38] mb-4">あわせて読みたい記事</h2>
        <ul class="space-y-2">
          {related.map((r: any) => (
            <li>
              <a
                href={`/blog/${r.slug?.current}`}
                class="block border border-gray-200 rounded-xl px-4 py-3 hover:border-[#1a4480] hover:bg-[#f0f4fa] transition-colors"
              >
                <span class="block text-xs text-gray-400">{r.publishedAt?.replace(/-/g, '.')}</span>
                <span class="block text-sm font-bold text-[#1a4480] leading-snug mt-0.5">{r.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <WardLinks />

    <div class="mt-10 text-center">
      <a href="/blog" class="text-[#2d5fa0] font-bold text-sm hover:underline">← 記事一覧に戻る</a>
    </div>
  </div>
</main>

</Layout>
